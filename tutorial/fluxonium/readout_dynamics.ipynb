  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Define the fluxonium parameters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Qubit parameters\n",
    "QUBIT_LABEL = \"fluxonium\"\n",
    "CHARGING_ENERGY: float = 1.0 * GHz\n",
    "INDUCTIVE_ENERGY: float = 0.275 * GHz\n",
    "JOSEPHSON_ENERGY: float = 5.0 * GHz\n",
    "EXT_FLUX: float = 0.5 * 2 * math.pi\n",
    "FOCK_CUTOFF: int = 1000\n",
    "QUBIT_DIM: int = 5"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Define the resonator parameters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [],
   "source": [
    "RES_LABEL: str = \"resonator\"\n",
    "RES_FREQ: float = 6.75 * GHz\n",
    "RES_IMPEDANCE: float = 50.0\n",
    "RES_DECAY_RATE: float = 2 * MHz\n",
    "RES_THERMAL_PHOTONS: float = 0.0\n",
    "RES_DIM: int = 5"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Define the coupling strength between the fluxonium and the resonator"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Coupling strength\n",
    "COUP_LABEL = \"coupling\"\n",
    "COUP_STRENGTH = 100 * MHz"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Set the readout drive parameters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [],
   "source": [
    "DRIVE_AMPLITUDE: float = 2.5 * MHz  # Drive amplitude\n",
    "PAD_TIME: float = 0 # Time before the pulse starts\n",
    "HOLD_TIME: float = 250 * ns  # Time the pulse is on\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [],
   "source": [
    "fluxonium = Fluxonium(\n",
    "    label=QUBIT_LABEL,\n",
    "    charging_energy=CHARGING_ENERGY,\n",
    "    inductive_energy=INDUCTIVE_ENERGY,\n",
    "    josephson_energy=JOSEPHSON_ENERGY,\n",
    "    ext_flux=EXT_FLUX,\n",
    "    fock_cutoff=FOCK_CUTOFF,\n",
    ")\n",
    "\n",
    "fluxonium.diagonalize(QUBIT_DIM)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
   "outputs": [],
   "source": [
    "resonator = HarmonicOscillator.from_frequency(\n",
    "    label=RES_LABEL,\n",
    "    frequency=RES_FREQ,\n",
    "    impedance=RES_IMPEDANCE,\n",
    "    dim=RES_DIM,\n",
    "    decay_rate=RES_DECAY_RATE,\n",
    "    thermal_photons=RES_THERMAL_PHOTONS,\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {},
   "outputs": [],
   "source": [
    "device = Device(fluxonium, resonator)\n",
    "\n",
    "coupling_strength = COUP_STRENGTH / resonator.charge_zpf\n",
    "coupling = get_capacitive_coupling(\n",
    "    label=COUP_LABEL,\n",
    "    system=fluxonium,\n",
    "    coupled_system=resonator,\n",
    "    coupling_strength=coupling_strength,\n",
    ")\n",
    "device.add_coupling(coupling)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [],
   "source": [
    "energies, state_vecs = device.get_eigenstates()\n",
    "\n",
    "ground_inds = jnp.argmax(jnp.abs(state_vecs[::RES_DIM]), axis=1)\n",
    "\n",
    "raise_op = resonator.get_raise_op()\n",
    "inds = get_branch_inds(state_vecs, raise_op, ground_inds)\n",
    "\n",
    "energies = energies[inds]\n",
    "state_vecs = state_vecs[:, inds]\n",
    "states = jnp.einsum(\"ia,ja->aij\", state_vecs, jnp.conj(state_vecs))\n",
    "\n",
    "energies = energies.reshape(QUBIT_DIM, RES_DIM)\n",
    "prod_dim  = QUBIT_DIM * RES_DIM\n",
    "states = states.reshape(QUBIT_DIM, RES_DIM, prod_dim, prod_dim)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [],
   "source": [
    "dressed_res_freq = energies[0, 1] - energies[0, 0]\n",
    "shifted_res_freq = energies[1, 1] - energies[1, 0]\n",
    "drive_frequency = 0.5 * (shifted_res_freq + dressed_res_freq)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "metadata": {},
   "outputs": [],
   "source": [
    "drive_amplitude = DRIVE_AMPLITUDE / resonator.charge_zpf\n",
    "partial_pulse = Partial(\n",
    "    readout_pulse,\n",
    "    drive_amplitude=drive_amplitude,\n",
    "    drive_frequency=drive_frequency,\n",
    "    pad_time=PAD_TIME,\n",
    "    hold_time=HOLD_TIME,\n",
    ")\n",
    "resonator.add_charge_drive(label=\"readout_pulse\", charge_pulse=partial_pulse)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "metadata": {},
   "outputs": [],
   "source": [
    "save_times = jnp.linspace(0, 500, 100)\n",
    "\n",
    "hamiltonian = get_hamiltonian(device)\n",
    "\n",
    "jump_ops = list(resonator.get_jump_ops())\n",
    "\n",
    "state_inds = [(0, 0), (1, 0)]\n",
    "state_list = [states[qubit_ind, res_ind] for qubit_ind, res_ind in state_inds]\n",
    "init_states = jnp.stack(state_list)\n",
    "\n",
    "res_low_op = resonator.get_low_op()\n",
    "res_number_op = resonator.get_number_op()\n",
    "\n",
    "qubit_number_op = fluxonium.get_number_op()\n",
    "\n",
    "branch_projectors = jnp.sum(states, axis=1)\n",
    "\n",
    "qubit_inds = jnp.arange(QUBIT_DIM)\n",
    "branch_number_op = jnp.einsum(\"i, ijk -> jk\", qubit_inds, branch_projectors)\n",
    "\n",
    "exp_ops = [res_low_op, res_number_op, qubit_number_op, branch_number_op]\n",
    "\n",
    "for ind in range(QUBIT_DIM):\n",
    "    exp_ops.append(branch_projectors[ind])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "metadata": {},
   "outputs": [],
   "source": [
    "options=dq.Options(save_states=True, verbose=True)\n",
    "solver = dq.solver.Tsit5(rtol=1e-8, atol=1e-8, max_steps=1000000)"
   ]
  },
